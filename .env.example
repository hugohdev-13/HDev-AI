# Flask session signing key. Generate a long random value for each environment.
SECRET_KEY=
# SQL Server connection settings.
DB_DRIVER=
DB_SERVER=
DB_DATABASE=
# Machine-to-machine key used by the n8n integration API.
N8N_API_KEY=
# Required only when executing database.seed_runner.
HDEV_ADMIN_EMAIL=
HDEV_ADMIN_PASSWORD=
# AI provider selection and model identifiers.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=
GEMINI_MODEL=mock-gemini
AZURE_OPENAI_MODEL=mock-azure
OLLAMA_MODEL=mock-ollama
# Automatic analysis policy.
AI_AUTO_ANALYZE_ON_CREATE=true
AI_AUTO_ANALYZE_ON_UPDATE=false
AI_REANALYZE_ON_CONTENT_CHANGE=true
